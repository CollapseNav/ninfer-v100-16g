161:bool ternary_volta_qpn_supported(std::int32_t n, std::int32_t k, std::int32_t t) noexcept {
163:    if (n <= 0 || k <= 0 || t <= 0) { return false; }
164:    if ((k % TernaryVoltaQpnSchedule::kGroupK) != 0) { return false; }
165:    // SPLITK warps split K by whole groups, and every warp must get at least one.
166:    if ((k / TernaryVoltaQpnSchedule::kGroupK) % kTernaryQpnSplitk != 0) { return false; }
167:    // The band. The kernel reads the whole weight once per forward whatever T is, and the tensor
168:    // cores then absorb the extra tokens almost free -- so its cost is flat in T, while the SIMT
169:    // tile kernel's grows by ~a third of a T=1 step per verified token. Measured round times on
170:    // real_task (ms, NINFER_TERNARY_QPN=0 against =1, same batch, 128 tokens each):
173:    //   19.5   26.6  33.9  41.2  48.6  58.0  74.1   98.1   SIMT tile
176:    // i.e. the two lines cross at T ~ 4.3. Below 6 the route loses (T = 2 by 47%, T = 3 by 21%),
177:    // which is the whole MTP band a real task uses -- K = 1 and K = 2 -- and 6 is the first width
178:    // where the win clears the +/-4% batch drift of this workload (18% at T = 6, 30% at T = 8, and
179:    // 2.1x at the T = 16 lookup verify). T = 1 is far worse than all of them: the A tile is eight
180:    // tokens tall whatever T is, so one token runs the schedule with seven eighths of M dead.
181:    if (t < 6) { return false; }
182:    return t <= 4 * TernaryVoltaQpnSchedule::kRowsPerTile;
186:    (void)t;
187:    return false;
