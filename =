95:    const int qp   = (lane >> 2) & 3;
96:    const int r    = (lane & 3) + ((lane & 16) != 0 ? 4 : 0);
97:    const int row  = tile * 32 + qp * 8 + r;
98:    const int stride = static_cast<int>(blockDim.x) >> 5;
99:    for (int g = static_cast<int>(threadIdx.x) >> 5; g < groups; g += stride) {
100:        const std::int64_t packed = (static_cast<std::int64_t>(tile) * groups + g) * 32 + lane;
101:        const std::uint8_t* src = src_codes + (static_cast<std::int64_t>(row) * groups + g) * 32;
102:        std::uint8_t* dst       = dst_codes + packed * 32;
104:        for (int b = 0; b < 32; ++b) { dst[b] = src[b]; }
