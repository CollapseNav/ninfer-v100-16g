121:void ternary_prepack_qpn(Weight& w, cudaStream_t stream) {
123:    const int groups = w.k / TernaryVoltaQpnSchedule::kGroupK;
124:    const std::size_t code_bytes  = static_cast<std::size_t>(w.n) * groups * 32;
125:    const std::size_t scale_bytes = static_cast<std::size_t>(w.n) * groups * sizeof(std::uint16_t);
126:    void* scratch = nullptr;
127:    CUDA_CHECK(cudaMalloc(&scratch, code_bytes + scale_bytes));
128:    auto* packed_codes  = static_cast<std::uint8_t*>(scratch);
129:    auto* packed_scales = reinterpret_cast<std::uint16_t*>(packed_codes + code_bytes);
130:    pq2_prepack_tile_kernel<<<static_cast<unsigned>(w.n / 32), 256, 0, stream>>>(
131:        static_cast<const std::uint8_t*>(w.qdata),
132:        reinterpret_cast<const std::uint16_t*>(w.scales), packed_codes, packed_scales, groups);
133:    CUDA_CHECK(cudaGetLastError());
134:    CUDA_CHECK(cudaMemcpyAsync(const_cast<void*>(w.qdata), packed_codes, code_bytes,
135:                               cudaMemcpyDeviceToDevice, stream));
136:    CUDA_CHECK(cudaMemcpyAsync(const_cast<void*>(w.scales), packed_scales, scale_bytes,
137:                               cudaMemcpyDeviceToDevice, stream));
138:    CUDA_CHECK(cudaStreamSynchronize(stream));
139:    CUDA_CHECK(cudaFree(scratch));
140:    prepacked_weights().insert(w.qdata);
143:    (void)stream;
